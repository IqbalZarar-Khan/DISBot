{
  "name": "patreon-discord-bot",
  "version": "1.0.0",
  "description": "Patreon Tier-Waterfall Bot for automated content distribution to Discord",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:ngrok": "ts-node scripts/dev-ngrok.ts",
    "dev:tunnel": "ts-node scripts/dev-tunnel.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy-commands": "ts-node src/commands/deploy-commands.ts",
    "setup:patreon": "ts-node scripts/fetch-patreon-config.ts",
    "verify": "ts-node src/scripts/verify-deployment.ts",
    "test:webhooks": "ts-node src/tests/manual-webhook-test.ts",
    "test:webhook": "ts-node scripts/test-webhook.ts",
    "setup:wizard": "ts-node scripts/setup-wizard.ts",
    "test": "jest",
    "test:integration": "jest --testPathPattern=integration"
  },
  "keywords": [
    "discord",
    "patreon",
    "bot",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.2",
    "bullmq": "^5.77.1",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^20.10.5",
    "jest": "^29.7.0",
    "localtunnel": "^2.0.2",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
