# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
GUILD_ID=your_discord_server_id_here
ROOT_ADMIN_ID=your_discord_user_id_here

# Patreon Configuration
PATREON_CLIENT_ID=your_patreon_client_id_here
PATREON_CLIENT_SECRET=your_patreon_client_secret_here
PATREON_ACCESS_TOKEN=your_patreon_access_token_here
PATREON_REFRESH_TOKEN=your_patreon_refresh_token_here
PATREON_CAMPAIGN_ID=your_patreon_campaign_id_here

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PORT=3000

# Supabase Configuration (Use service_role key for RLS database access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Tier Configuration
# JSON array of tiers. Rank 100 = Highest Priority, Rank 0 = Free
# IDs come from Patreon (check bot logs when creating posts)
# cents: Optional pledge amount in cents for fallback tier detection
# Format: [{"name":"TierName","id":"PatreonTierID","rank":RankNumber,"cents":AmountInCents}]
TIER_CONFIG='[{"name":"Tier1","id":"TIER_ID_1","rank":100,"cents":2500},{"name":"Tier2","id":"TIER_ID_2","rank":75,"cents":1500},{"name":"Tier3","id":"TIER_ID_3","rank":50,"cents":1000},{"name":"Tier4","id":"TIER_ID_4","rank":25,"cents":300},{"name":"Tier5","id":"TIER_ID_5","rank":0,"cents":0}]'

# Logging
LOG_CHANNEL_ID=your_admin_log_channel_id_here

# Redis (optional — enables BullMQ queue and distributed caching; bot auto-degrades if unset)
# Railway: use your Railway Redis add-on internal URL
REDIS_URL=redis://localhost:6379

# Role Sync (optional — set to 'true' to enable automatic Discord role management)
DISCORD_ROLE_SYNC_ENABLED=false

# Public URL (used for dashboard links, setup wizard, and OAuth callbacks)
# Set this to your Railway/VPS domain, e.g. https://your-app.up.railway.app
PUBLIC_URL=

# Locale (optional — defaults to 'en'; shipped: en, es, de, fr, ja, zh-CN, ru, id)
BOT_LOCALE=en

# Metrics endpoint auth (optional — /metrics is open when unset).
# When set, scrape with: Authorization: Bearer <token> (or ?token=<token>)
METRICS_TOKEN=

# Operational & Security Overrides (optional)
# DISABLE_SETUP_WIZARD=true       # Disable /setup web wizard completely in production
# ALLOW_WIZARD_RECONFIG=true      # Allow re-running /setup wizard after initial completion
# ALLOW_RANK_INVERSION=true       # Bypass fatal exit if cheaper tiers outrank expensive ones

# ─── Docker Compose Only ────────────────────────────────────────────
# Required when running via docker-compose (self-hosted PostgreSQL + PostgREST)
DB_PASSWORD=generate_a_strong_password_here
POSTGREST_JWT_SECRET=generate_a_random_string_min_32_chars_here
